<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Suite">

	<listeners>
		<listener class-name="testUtilities.listeners" />
	</listeners>

	<test thread-count="5" name="Sanity Tests">

		<groups>
			<run>
				<include name="sanity" />
			</run>
		</groups>

		<classes>
			<class name="tests.calculatorTest_Add_Subtract" />
			<class name="tests.calculatorTest_Multiply_Divide" />			
		</classes>

	</test>
</suite> 

